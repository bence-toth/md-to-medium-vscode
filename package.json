{
  "name": "markdown-to-medium-vscode",
  "displayName": "Markdown to Medium",
  "description": "Copy Markdown as Medium-ready rich HTML",
  "version": "0.1.0",
  "private": true,
  "publisher": "tbd",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tbd/markdown-to-medium-vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mdToMedium.copyAsMediumHtml",
        "title": "Markdown to Medium: Copy as Medium HTML"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mdToMedium.copyAsMediumHtml",
          "when": "resourceLangId == markdown"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.21.0",
    "eslint": "^8.57.0",
    "prettier": "^3.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "md-to-medium": "^1.0.0"
  }
}
